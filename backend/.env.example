# Database Settings
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=multitenant_pos

# JWT Settings
# Generate a strong, secure secret key
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=8h

# Google Cloud Vision Settings
# Path to your Google Cloud service account JSON key file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_CLOUD_CREDENTIALS_PATH=/path/to/your/service-account-key.json
